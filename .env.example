# Copie para .env (que está no .gitignore). NUNCA commite o .env.
# Nenhuma fonte atual exige chave de API. Se adicionar SPTrans/Olho Vivo, o token vai aqui
# e é lido no DAG por Variable (AIRFLOW_VAR_SPTRANS_TOKEN), nunca escrito no código.

SP156_N_TRIMESTRES=2
OPENMETEO_LAT=-23.55
OPENMETEO_LON=-46.63

# Opcional: URL de webhook (Slack/Teams/Discord) para a notificação de falha do DAG
NOTIFY_WEBHOOK_URL=

# Opcional (fonte extra, não usada por padrão)
# AIRFLOW_VAR_SPTRANS_TOKEN=
